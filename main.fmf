/plan:
  provision:
  hardware:
    cpu:
      processors: 48
    memory: "384 GiB"
    disk:
      - size: "500 GiB"
    virtualization:
      is-virtualized: false
      is-supported: true

  discover:
    how: fmf

  execute:
    how: tmt

  prepare:
    - name: Disable weak dep installation
      how: shell
      order: 10
      script: echo "install_weak_deps=False" >> /etc/dnf/dnf.conf

    - name: Install test + libvirt dependencies
      how: install
      package:
        - util-linux
        - procps-ng
        - python3
        - python3-pip
        - git-core
        - rsync
        - openssh-clients
        - podman
        # libvirt & dependencies
        - libvirt-daemon
        - libvirt-daemon-driver-qemu
        - libvirt-daemon-driver-storage-disk
        - qemu-kvm
        - libvirt-client
        - virt-install
        - libguestfs-tools-c
        - xfsprogs
        - mdadm

    - name: Examine hardware
      how: shell
      script: |
        set -x +e
        lscpu
        lsmem
        lsblk
        df -h
        mount

    - name: Set up NVMe disks for use as libvirt storage
      how: shell
      script: ./setup-disks.sh

    - name: Install atex
      how: shell
      # install the same ref as was used for this repo (contest_atex)
      script: |
        if [[ $TESTING_FARM_GIT_REF ]]; then
          python3 -m pip install "git+https://github.com/RHSecurityCompliance/atex.git@$TESTING_FARM_GIT_REF"
        else
          python3 -m pip install atex
        fi

    - name: Copy atex-virt-helper to /usr/local/bin
      how: shell
      script: ./install-helper.py

    - name: Set up libvirt and domains
      how: shell
      script: ./setup-libvirt.sh

    - name: Clone and build CaC/content and Contest
      how: shell
      script: ./clone-repos.sh

    - name: Generate an ssh key for connecting to VMs
      how: shell
      script: ssh-keygen -t rsa -f "$VM_SSH_KEY" -N ''

    - name: Pre-install CentOS VM images
      how: shell
      script: ./install-images.sh

    - name: Free up resources
      how: shell
      script: |
        set -x +e
        # we don't need built content (already copied into VM images)
        rm -rf "$CONTENT_DIR_8" "$CONTENT_DIR_9" "$CONTENT_DIR_10"
        # don't need podman anymore
        podman system reset --force
        # free up page cache
        sync
        echo 3 > /proc/sys/vm/drop_caches

  finish:
    - name: Check disk usage (for debugging)
      how: shell
      script: |
        set -x +e
        df -h
        ls -lsh /var/lib/libvirt/images

  environment:
    CONTENT_DIR_8: /root/content/cs8
    CONTENT_DIR_9: /root/content/cs9
    CONTENT_DIR_10: /root/content/cs10
    INSTALL_URL_8: https://vault.centos.org/8-stream/BaseOS/x86_64/os/
    INSTALL_URL_9: https://mirror.stream.centos.org/9-stream/BaseOS/x86_64/os/
    INSTALL_URL_10: https://mirror.stream.centos.org/10-stream/BaseOS/x86_64/os/
    CONTEST_DIR: /root/contest
    VM_SSH_KEY: /root/ssh_key
    CONTENT_ON_VM: /root/upstream-content

/test:
  test: |
    set -x -e
    ./run-testing.py
    ./render-results.sh
  duration: 8h
