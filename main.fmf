/plan:
  provision:
    hardware:
      cpu:
        model-name: "=~ .*8488C.*"
      memory: "384 GiB"
      disk:
        - size: "100 GiB"
      virtualization:
        is-virtualized: false
        is-supported: true

  discover:
    how: fmf

  execute:
    how: tmt

  prepare:
    - name: Disable weak dep installation
      how: shell
      order: 10
      script: echo "install_weak_deps=False" >> /etc/dnf/dnf.conf

    - name: Install test + environmental dependencies
      how: install
      package:
        - xz
        - jq
        - util-linux
        - procps-ng
        - python3
        - python3-pip
        - git-core
        - rsync
        - podman
        - xfsprogs

    - name: Examine hardware
      how: shell
      script: |
        set -x +e
        lscpu
        lsmem
        lsblk
        df -h
        mount

    - name: Set up zram for use as container storage
      how: shell
      script: ./setup-disks.sh

    - name: Install atex
      how: shell
      script: |
        python3 -m pip install git+https://github.com/RHSecurityCompliance/atex.git@devel

    - name: Clone and build CaC/content and Contest
      how: shell
      script: ./clone-repos.sh

    - name: Pre-install per-CS podman images
      how: shell
      script: ./build-images.sh

    - name: Free up resources
      how: shell
      script: |
        set -x +e
        # we don't need built content (already copied into podman images)
        rm -rf "$CONTENT_DIR_8" "$CONTENT_DIR_9" "$CONTENT_DIR_10"
        # free up page cache
        sync
        echo 3 > /proc/sys/vm/drop_caches

  finish:
    - name: Check disk usage (for debugging)
      how: shell
      script: |
        set -x +e
        df -h
        ls -lsh /var/lib/containers
        dmesg | grep -vE \
          -e "zram: Cannot change disksize for initialized device" \
          -e "port [^ ]+ entered [^ ]+ state$" \
          -e ": entered (promiscuous|allmulticast) mode$" \
          -e ".unregistering.: left [^ ]+ mode$"

  environment:
    # use the zram-backed storage to avoid slow network-based root
    CONTENT_DIR_8: /var/lib/containers/tmp/content/cs8
    CONTENT_DIR_9: /var/lib/containers/tmp/content/cs9
    CONTENT_DIR_10: /var/lib/containers/tmp/content/cs10
    CONTEST_DIR: /var/lib/containers/tmp/contest
    CONTENT_IN_IMAGE: /root/upstream-content

/test:
  duration: 12h
  test: |
    set -x -e +o pipefail

    ./run-testing.py

    ./render-results.sh

    # at least one pass
    if ! xzcat runs/results.json.xz | jq -n -e 'first(inputs | select(.[1] == "pass"))'; then
      echo "no pass results found"
      exit 1
    fi

    # exit with 1 on failure
    if xzcat runs/results.json.xz | jq -n -e 'first(inputs | select(.[1] | IN("fail","error","infra")))'; then
      echo "at least one failure found"
      exit 1
    fi

    exit 0
